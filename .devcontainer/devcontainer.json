{
  "name": "kali",
  "image": "ghcr.io/rahulmutt/dev:sha-ba1dc42",
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  "containerEnv": {
    "CARGO_HOME": "/home/dev/.cargo",
    "RUSTUP_HOME": "/home/dev/.rustup"
  },
  "mounts": [
    "source=devpod-home-cache,target=/home/dev/.cache,type=volume",
    "source=devpod-home-local,target=/home/dev/.local,type=volume",
    "source=devpod-cargo,target=/home/dev/.cargo,type=volume",
    "source=devpod-rustup,target=/home/dev/.rustup,type=volume"
  ],
  "postCreateCommand": "post-create.sh",
  "customizations": {
    "devpod": {
      "ide": "none"
    }
  }
}

