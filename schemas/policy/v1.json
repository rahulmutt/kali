{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/policy/v1",
  "title": "Kali Sandbox Policy v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "effects",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "$schema": {
      "type": "string"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileSystem",
        "network",
        "process",
        "timer",
        "eval",
        "random",
        "console"
      ],
      "properties": {
        "fileSystem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write"
          ],
          "properties": {
            "read": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "write": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fetch",
            "connect",
            "listen",
            "maxConnections"
          ],
          "properties": {
            "fetch": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "connect": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "listen": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "maxConnections": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spawn",
            "envRead",
            "envWrite"
          ],
          "properties": {
            "spawn": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "envRead": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "envWrite": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "timer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schedule",
            "maxTimeoutMs",
            "maxActiveTimers"
          ],
          "properties": {
            "schedule": {
              "type": "boolean"
            },
            "maxTimeoutMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "maxActiveTimers": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "eval": {
          "type": "boolean"
        },
        "random": {
          "type": "boolean"
        },
        "console": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxMemoryMB": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxCpuTimeMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxOpenFiles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxSpawnedProcesses": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxThreads": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
