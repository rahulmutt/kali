{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kali Benchmark Fixture Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark", "version", "sourceFile", "sourceSha256", "buildModes"],
  "properties": {
    "benchmark": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "const": 1
    },
    "sourceFile": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-benchmark-v1\\.ts$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "buildModes": {
      "type": "array",
      "prefixItems": [
        {
          "const": "--fast"
        },
        {
          "const": "--release"
        },
        {
          "const": "--release-advanced"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
