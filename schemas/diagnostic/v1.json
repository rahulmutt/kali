{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/diagnostic/v1",
  "title": "Kali Diagnostic v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "severity",
    "code",
    "message",
    "span",
    "labels",
    "related",
    "fix",
    "notes"
  ],
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[EWI][0-9]{4}$"
    },
    "message": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "file",
          "line",
          "column",
          "endLine",
          "endColumn"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "endLine": {
            "type": "integer",
            "minimum": 1
          },
          "endColumn": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string"
          },
          "isPrimary": {
            "type": "boolean"
          }
        }
      }
    },
    "help": {
      "type": [
        "string",
        "null"
      ]
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "fix": {
      "type": [
        "null",
        "object"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "cli",
            "config",
            "default",
            "source"
          ]
        },
        "configPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "flag": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestedValue": {},
        "effectiveValue": {}
      }
    }
  }
}
