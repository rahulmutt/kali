{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/result/check/v1",
  "title": "Kali Check Result v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "filesChecked",
    "errorCount",
    "warningCount"
  ],
  "properties": {
    "filesChecked": {
      "type": "integer",
      "minimum": 0
    },
    "errorCount": {
      "type": "integer",
      "minimum": 0
    },
    "warningCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
