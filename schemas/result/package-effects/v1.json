{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/result/package-effects/v1",
  "title": "Kali Package Effects Result v1",
  "description": "Native JSON payload emitted by `kali package-effects`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "report"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "registry"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "analysisContext",
        "entryPoints",
        "effects",
        "dynamicEffects",
        "dynamicReasons"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "analysisContext": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiSurface",
            "runtimeProfiles",
            "compatFeatures"
          ],
          "properties": {
            "apiSurface": {
              "type": "string",
              "minLength": 1
            },
            "runtimeProfiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "compatFeatures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "entryPoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "locations"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "file",
                    "line",
                    "column"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "column": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "function": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "dynamicEffects": {
          "type": "boolean"
        },
        "dynamicReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
