{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/result/test/v1",
  "title": "Kali Test Result v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "total",
    "passed",
    "failed",
    "skipped",
    "runtimeMs"
  ],
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "runtimeMs": {
      "type": "integer",
      "minimum": 0
    },
    "hostContract": {
      "type": "string",
      "minLength": 1
    },
    "runtimeBackend": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "files", "summary"],
      "properties": {
        "mode": {
          "const": "function"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "functionsTotal", "functionsCovered", "functionsMissed"],
            "properties": {
              "file": {
                "type": "string"
              },
              "functionsTotal": {
                "type": "integer",
                "minimum": 0
              },
              "functionsCovered": {
                "type": "integer",
                "minimum": 0
              },
              "functionsMissed": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["functionsTotal", "functionsCovered", "functionsMissed", "coveragePercent"],
          "properties": {
            "functionsTotal": {
              "type": "integer",
              "minimum": 0
            },
            "functionsCovered": {
              "type": "integer",
              "minimum": 0
            },
            "functionsMissed": {
              "type": "integer",
              "minimum": 0
            },
            "coveragePercent": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
