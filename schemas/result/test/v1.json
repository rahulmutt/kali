{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/result/test/v1",
  "title": "Kali Test Result v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "total",
    "passed",
    "failed",
    "skipped",
    "runtimeMs"
  ],
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "runtimeMs": {
      "type": "integer",
      "minimum": 0
    }
  }
}
