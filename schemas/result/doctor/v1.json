{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/result/doctor/v1",
  "title": "Kali Doctor Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "browserHarness",
    "browserRuntimeContract"
  ],
  "properties": {
    "browserHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envVar",
        "source",
        "override",
        "command",
        "executable",
        "args",
        "executableAvailable"
      ],
      "properties": {
        "envVar": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "env",
            "auto"
          ]
        },
        "override": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executableAvailable": {
          "type": "boolean"
        }
      }
    },
    "browserRuntimeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostLabel",
        "hostDescription",
        "hostDescriptionNote",
        "supportedCommands",
        "diagnosticHint",
        "diagnosticNotes"
      ],
      "properties": {
        "hostLabel": {
          "type": "string",
          "const": "browser-requested"
        },
        "hostDescription": {
          "type": "string",
          "minLength": 1
        },
        "hostDescriptionNote": {
          "const": "browser runtime host description: real browser host"
        },
        "supportedCommands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "diagnosticHint": {
          "type": "string",
          "minLength": 1
        },
        "diagnosticNotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
