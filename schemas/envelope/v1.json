{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/envelope/v1",
  "title": "Kali CLI Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "success",
    "errors",
    "warnings",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "success": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "https://kali-lang.org/schemas/diagnostic/v1"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "https://kali-lang.org/schemas/diagnostic/v1"
      }
    },
    "payload": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout": {
      "type": [
        "string",
        "null"
      ]
    },
    "stderr": {
      "type": [
        "string",
        "null"
      ]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "timings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timing"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary-executable",
            "primary-library",
            "primary-component",
            "browser-glue",
            "interface-wit",
            "embedding-header",
            "embedding-metadata",
            "binding-package-manifest",
            "debug-source-map"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "milliseconds"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "milliseconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
