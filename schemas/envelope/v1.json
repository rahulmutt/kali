{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kali-lang.org/schemas/envelope/v1",
  "title": "Kali CLI Envelope v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "command",
    "success",
    "errors",
    "warnings",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "type": "string"
    },
    "success": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "https://kali-lang.org/schemas/diagnostic/v1"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "https://kali-lang.org/schemas/diagnostic/v1"
      }
    },
    "payload": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout": {
      "type": [
        "string",
        "null"
      ]
    },
    "stderr": {
      "type": [
        "string",
        "null"
      ]
    },
    "timings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "milliseconds"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "milliseconds": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "exitCode": {
      "type": "integer"
    }
  }
}
