+/// fires, the conditional `queue_microtask` import would be undeclared and
+/// emitting a `Call` to it would be invalid wasm — so over-inclusiveness here
+/// is the safe side.
+pub(crate) fn program_uses_queue_microtask(lir: &LirProgram) -> bool {
+    lir.nodes.iter().any(|node| {
+        if node.kind != LirNodeKind::Call {
+            return false;
+        }
+        let Some(callee) = node.children.first() else {
+            return false;
+        };
+        let Some(callee_node) = lir.nodes.get(callee.0 as usize) else {
+            return false;
+        };
+        callee_node.text.as_deref() == Some("queueMicrotask")
+    })
+}
